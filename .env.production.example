# Domain for SSL certificate and nginx
DOMAIN=x1rewards.xyz

# PostgreSQL password (change this!)
POSTGRES_PASSWORD=change_me_to_a_strong_password

# X1 RPC endpoint
X1_RPC_URL=https://rpc.mainnet.x1.xyz

# Xen.network API URL
XEN_API_URL=https://api.xen.network

# Frontend X1 RPC URL (used by browser)
VITE_X1_RPC_URL=https://rpc.mainnet.x1.xyz
